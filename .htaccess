<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Establece la base de la reescritura en la raíz del dominio
    RewriteBase /
    
    # Si la petición no es un archivo físico que exista
    RewriteCond %{REQUEST_FILENAME} !-f
    # Si la petición no es una carpeta física que exista
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Envía todo el tráfico al index.php de forma limpia
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

